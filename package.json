{
  "name": "3d-configurator",
  "private": true,
  "type": "module",
  "description": "Configurator-as-a-Service — embeddable 3D product configurator, model pipeline, and (coming) merchant Studio",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @allin/embed",
    "test": "npm test -w @allin/embed",
    "test:unit": "npm run test:unit -w @allin/embed",
    "test:browser": "npm run test:browser -w @allin/embed",
    "check:manifest": "node packages/embed/tools/check-manifest.ts apps/demo/tap-bar-3.manifest.json",
    "serve": "node -e \"const h=require('node:http'),f=require('node:fs'),p=require('node:path');const R='apps/demo';const T={'.html':'text/html','.js':'text/javascript','.css':'text/css','.json':'application/json','.glb':'model/gltf-binary'};h.createServer((q,s)=>{const u=decodeURIComponent(q.url.split('?')[0]);const x=p.join(R,u==='/'?'index.html':u);if(!x.startsWith(R)||!f.existsSync(x)){s.writeHead(404);return s.end()}s.writeHead(200,{'content-type':T[p.extname(x)]||'application/octet-stream'});s.end(f.readFileSync(x))}).listen(4321,()=>console.log('http://localhost:4321'))\""
  }
}
