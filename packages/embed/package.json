{
  "name": "@allin/embed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Embeddable product configurator \u2014 manifest-driven renderer and model pipeline",
  "scripts": {
    "test": "node --test --experimental-strip-types \"test/*.test.ts\" && node test/demo.smoke.mjs && node test/custom-mount-check.mjs",
    "test:unit": "node --test --experimental-strip-types \"test/*.test.ts\"",
    "test:browser": "node test/demo.smoke.mjs && node test/custom-mount-check.mjs",
    "check:manifest": "node tools/check-manifest.ts",
    "build": "rm -f ../../apps/demo/embed-*.js && esbuild src/embed.ts --bundle --format=esm --splitting --target=es2022 --minify --outdir=../../apps/demo --chunk-names=embed-[name]-[hash] && cp src/embed.css ../../apps/demo/embed.css",
    "build:model": "node tools/build-model.mjs",
    "build:standalone": "node tools/bundle-demo.mjs ../../apps/demo/standalone.html"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "meshoptimizer": "^1.2.0",
    "three": "^0.185.1",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.14"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "playwright-core": "^1.62.0"
  }
}
