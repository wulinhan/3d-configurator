# Copy to .env for local work. In production these are Fly secrets — every
# one of them is a credential or a URL that must not be guessable from the
# repository.
#
#   flyctl secrets set DATABASE_URL="..." S3_ACCESS_KEY_ID="..." ...

# ── required ──────────────────────────────────────────────────────────────

# Neon. Use the POOLED endpoint (the host with `-pooler` in it): this service
# opens a connection per instance and Neon's direct endpoint has a low cap.
# sslmode=require is not optional — the connection crosses the internet.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/configurator?sslmode=require

# The Studio's URL. Sign-in links point here, so a wrong value emails
# merchants a link to nowhere.
APP_BASE=https://studio.example.com

# This service's URL. Manifest, model and upload URLs are built from it and
# BAKED INTO PUBLISHED MANIFESTS, so changing it later strands every product
# already published. Decide the hostname before the first publish.
PUBLIC_BASE=https://api.example.com

# Comma-separated. Cookie-authenticated writes must carry one of these as
# their Origin — this is the CSRF defence, so it is not decoration.
STUDIO_ORIGINS=https://studio.example.com

# ── object storage (Cloudflare R2) ────────────────────────────────────────
# Omit the whole block and bytes go to ./.storage on local disk, which is
# right for development and wrong for anything with more than one machine.

S3_BUCKET=configurator
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# A public domain in front of the bucket. Set it and published models are
# served from the edge and never pass through this process — which is the
# whole reason publications are immutable. Leave it unset and the service
# streams them itself: correct, just slower and more expensive.
CDN_BASE=https://models.example.com

# ── email ─────────────────────────────────────────────────────────────────
# Without these, sign-in links print to the log. Fine locally; in production
# it means nobody can sign in.

RESEND_API_KEY=
MAIL_FROM=Studio <studio@example.com>

# ── behaviour ─────────────────────────────────────────────────────────────

# 'lax' when the Studio and this service share a registrable domain
# (studio.example.com + api.example.com). On genuinely different domains the
# browser drops the session cookie in SILENCE — use 'none', which forces
# Secure with it.
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# Only true behind a load balancer that sets X-Forwarded-For. Set it wrongly
# and every caller picks their own rate-limit bucket.
TRUST_PROXY=true

SESSION_TTL_DAYS=30
LOGIN_TTL_MINUTES=15
MAX_MODEL_BYTES=67108864
MAX_IMAGE_BYTES=8388608
REVISIONS_KEPT=50
PORT=8080
